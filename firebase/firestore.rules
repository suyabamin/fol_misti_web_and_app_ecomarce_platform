rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    // Check if the user is authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is the resource owner by UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user has administrative privileges
    // Either through custom claim { admin: true } or by existing in /admins collection
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Check if user is an authorized delivery rider
    // Either through custom claim { delivery: true } or by existing in /deliveryProfiles
    function isDelivery() {
      return isAuthenticated() && (
        request.auth.token.delivery == true ||
        exists(/databases/$(database)/documents/deliveryProfiles/$(request.auth.uid))
      );
    }

    // =========================================================================
    // 1. ADMINS COLLECTION
    // =========================================================================
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only manageable via Firebase Admin SDK / Console
    }

    // =========================================================================
    // 2. USERS & PROFILES COLLECTION
    // =========================================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      // Customers can update their own profile; admins can update all fields (roles, status)
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 3. PRODUCTS & CATALOG (Public read, Admin manage)
    // =========================================================================
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 4. CATEGORIES (Public read, Admin manage)
    // =========================================================================
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 5. ORDERS COLLECTION
    // =========================================================================
    match /orders/{orderId} {
      // Order is readable by: customer owner, assigned delivery rider, or admin
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.assignedDeliveryPersonId == request.auth.uid ||
        isAdmin()
      );
      // Customer can create an order for their own account
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Customer can update for receipt confirmation / cancellation; rider for delivery state; admin for all
      allow update: if isAdmin() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          resource.data.assignedDeliveryPersonId == request.auth.uid
        )
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 6. CUSTOMER REVIEWS & RATINGS
    // =========================================================================
    match /reviews/{reviewId} {
      // Approved reviews are public; customers can view their own; admin can view all
      allow read: if resource.data.status == 'approved' || (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Customer can update their own review; admin can update all (moderation)
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 7. COUPONS & PROMOTIONS (Public read active, Admin manage)
    // =========================================================================
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 8. BANNERS (Public read active, Admin manage)
    // =========================================================================
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 9. STORE SETTINGS & THEMES (Public read, Admin manage)
    // =========================================================================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 10. WISHLISTS
    // =========================================================================
    match /wishlists/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // =========================================================================
    // 11. DELIVERY AREAS (Public read, Admin manage)
    // =========================================================================
    match /deliveryAreas/{areaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 12. DELIVERY PROFILES (Riders)
    // =========================================================================
    match /deliveryProfiles/{deliveryPersonId} {
      allow read: if (isAuthenticated() && request.auth.uid == deliveryPersonId) || isAdmin();
      // Riders can update availability & schedule; admins can update all
      allow update: if (
        isAuthenticated() &&
        request.auth.uid == deliveryPersonId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'totalEarnedDeliveryCharge',
          'totalPaidAmount',
          'outstandingPayableAmount',
          'status',
          'uid'
        ])
      ) || isAdmin();
      allow create, delete: if isAdmin();
    }

    // =========================================================================
    // 13. DELIVERY ASSIGNMENTS
    // =========================================================================
    match /deliveryAssignments/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.deliveryPersonId == request.auth.uid ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/orders/$(orderId)) &&
         get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid)
      );
      allow write: if isAdmin() || (
        isAuthenticated() && resource.data.deliveryPersonId == request.auth.uid
      );
    }

    // =========================================================================
    // 14. LIVE GPS DELIVERY LOCATIONS
    // =========================================================================
    match /deliveryLocations/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.deliveryPersonId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/orders/$(orderId)) &&
         get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid)
      );
      // The assigned delivery rider can transmit live coordinates; admin can manage
      allow create, update: if (
        isAuthenticated() &&
        request.resource.data.deliveryPersonId == request.auth.uid
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 15. PERMANENT ORDER ARCHIVES
    // =========================================================================
    match /orderArchives/{orderId} {
      // Readable by customer owner or admin
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      // Created on customer receipt confirmation or admin action
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      // Customer can update archive to submit star rating & review comment
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 16. DELIVERY EARNINGS LEDGER
    // =========================================================================
    match /deliveryEarnings/{entryId} {
      // Rider can inspect their own earnings; admin can view all
      allow read: if isAuthenticated() && (
        resource.data.deliveryPersonId == request.auth.uid ||
        isAdmin()
      );
      // Created on verified customer receipt confirmation or admin management
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 17. DELIVERY PAYMENTS (Admin Payouts to Riders)
    // =========================================================================
    match /deliveryPayments/{paymentId} {
      // Rider can view their own payout receipts; admin can manage
      allow read: if isAuthenticated() && (
        resource.data.deliveryPersonId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // =========================================================================
    // 18. DELIVERY DISPUTE ISSUES
    // =========================================================================
    match /deliveryIssues/{issueId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.deliveryPersonId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 19. REAL-TIME CUSTOMER LIVE SUPPORT CHAT
    // =========================================================================
    match /supportConversations/{convId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/supportConversations/$(convId)).data.userId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isAuthenticated() && (
          (get(/databases/$(database)/documents/supportConversations/$(convId)).data.userId == request.auth.uid && request.resource.data.senderId == request.auth.uid) ||
          isAdmin()
        );
        allow update, delete: if isAdmin();
      }
    }

  }
}
