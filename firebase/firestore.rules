rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admin whitelist collection
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only manageable via Cloud Functions / Admin SDK
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Products collection - public read, admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories collection - public read, admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders collection - customer can read their own, admin can read/write all
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Direct client order creation is strictly validated; preferred via Cloud Functions
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Reviews collection - approved reviews are public
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Coupons collection - public read active, admin write
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banners collection - public read active, admin write
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings collection (appearance, store settings)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Wishlists collection - user owns their wishlist
    match /wishlists/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Delivery Areas collection - public read, admin write
    match /deliveryAreas/{areaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Delivery Profiles collection
    match /deliveryProfiles/{deliveryPersonId} {
      allow read: if (isAuthenticated() && request.auth.uid == deliveryPersonId) || isAdmin();
      // Delivery person can update only permitted fields (schedule, availability)
      allow update: if (
        isAuthenticated() &&
        request.auth.uid == deliveryPersonId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'totalEarnedDeliveryCharge',
          'totalPaidAmount',
          'outstandingPayableAmount',
          'status',
          'uid'
        ])
      ) || isAdmin();
      allow create, delete: if isAdmin();
    }

    // Delivery Assignments collection
    match /deliveryAssignments/{orderId} {
      allow read: if (
        isAuthenticated() &&
        (resource.data.deliveryPersonId == request.auth.uid ||
         get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid ||
         isAdmin())
      );
      allow write: if isAdmin();
    }

    // Delivery Locations - active live GPS tracking
    match /deliveryLocations/{orderId} {
      allow read: if (
        isAuthenticated() &&
        (resource.data.deliveryPersonId == request.auth.uid ||
         get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid ||
         isAdmin())
      );
      // Only the currently assigned active delivery person can update location
      allow create, update: if (
        isAuthenticated() &&
        request.resource.data.deliveryPersonId == request.auth.uid &&
        get(/databases/$(database)/documents/orders/$(orderId)).data.assignedDeliveryPersonId == request.auth.uid
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Permanent Order Archives
    match /orderArchives/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Archives are created through trusted backend or customer receipt confirmation
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Delivery Earnings Ledger
    match /deliveryEarnings/{entryId} {
      allow read: if isAuthenticated() && (resource.data.deliveryPersonId == request.auth.uid || isAdmin());
      // Ledger writes are strictly managed via Cloud Functions / trusted backend
      allow write: if isAdmin();
    }

    // Delivery Payments
    match /deliveryPayments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.deliveryPersonId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Delivery Issues
    match /deliveryIssues/{issueId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Support Conversations - customer owns or admin manages
    match /supportConversations/{convId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/supportConversations/$(convId)).data.userId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isAuthenticated() && (
          (get(/databases/$(database)/documents/supportConversations/$(convId)).data.userId == request.auth.uid && request.resource.data.senderId == request.auth.uid) ||
          isAdmin()
        );
        allow update, delete: if isAdmin();
      }
    }
  }
}
